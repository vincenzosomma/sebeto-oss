{
  "name": "@sebeto/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && electron .",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "stage": "node scripts/stage.mjs",
    "dist": "npm run build --prefix ../.. && node scripts/stage.mjs && electron-builder --publish never"
  },
  "dependencies": { "@sebeto/core": "*" },
  "devDependencies": { "electron": "42.11.18", "electron-builder": "26.18.0", "@electron/rebuild": "^4.0.1" }
}
